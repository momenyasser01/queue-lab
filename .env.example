PORT=3000
QUEUE_BACKEND=pg

# Postgres container (infra/compose.yaml). Applied only when its volume is first created.
# Change POSTGRES_PORT if another Postgres already uses 5432 on this machine.
POSTGRES_USER=queuelab
POSTGRES_PASSWORD=queuelab
POSTGRES_DB=queuelab
POSTGRES_PORT=5432
# Must use the same user, password, port and database as above (dotenv does not expand ${...}).
DATABASE_URL=postgres://queuelab:queuelab@localhost:5432/queuelab

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# pg backend lease timings (ms)
LEASE_MS=30000
HEARTBEAT_MS=10000
REAP_MS=5000
SHUTDOWN_GRACE_MS=20000
